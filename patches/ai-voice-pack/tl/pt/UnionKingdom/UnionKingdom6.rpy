# -*- encoding: utf-8 -*-
# Arc: UnionKingdom | Scene: UnionKingdom6

translate pt strings:

    old "A knife to my throat, I was all but done, my Lady."
    new "Uma faca na garganta, eu estava quase feito, minha Senhora."

    old "A kiss?"
    new "Um beijo?"

    old "A brief moment later, he came back out."
    new "Um breve momento depois, ele voltou."

    old "A great path lead up to the dais, where atop the stairs sat the throne of Normandi."
    new "Um grande caminho levava até o dais, onde, no topo das escadas, estava o trono de Normandi."

    old "A miniscule smile crept along Queen Maeiv's face."
    new "Um sorriso minúsculo se espalhou pelo rosto da Rainha Maeiv."
