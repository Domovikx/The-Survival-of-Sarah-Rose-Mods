# -*- encoding: utf-8 -*-
# Arc: MagePath | Scene: MageInTheRuins3

translate pl strings:

    old "A lifetime of protocol and proper decorum, all forgotten after just a few years with her."
    new "Całe życie pełne protokołu i należytego szacunku, wszystko zapomniane już po kilku latach z nią."

    old "Spend the day with Samayra"
    new "Przebyj dzień z Samayrą"

    old "Go visit Alaric"
    new "Odwiedź Alarica"

    old "A lie."
    new "Kłamstwo."

    old "A chaotic surge of butterflies in her stomach."
    new "Chaotyczna fala motyli w jej żołądku."

    old "A long pause lingered before Alaric finally spoke."
    new "Długa pauza przetrwała przed tym, aż Alaric wreszcie przemówił."

    old "Spend the day alone"
    new "Przebyj dzień sam"

    old "Have drinks with Captain Belmont"
    new "Popij z Panem Belmontem"

    old "A couple, to be sure."
    new "Para, rzecz jasna."

    old "Go with Belmont to his ship"
    new "Idź z Belmontem na jego statek"

    old "A few gestured and looked in their direction, but for the most part, nobody noticed them."
    new "Kilku gestykulowało i spojrzało w ich stronę, ale w większości nikt ich nie zauważył."

    old "A brief moment of shame."
    new "Krótka chwila wstydu."

    old "Talk back"
    new "Odpowiedz"

    old "A deafening cracking sound rang out across the room."
    new "Ostrzały pęknięcie rozległo się po całym pokoju."

    old "Agree with Belmont"
    new "Zgodzić się z Belmontem"

    old "Go home"
    new "Wróć do domu"

    old "Tell him to get lost"
    new "Powiedz mu, by się wybrał"

    old "A brief flash of magical flame brushed along her hand."
    new "Krótka iskra magicznego płomienia dotknęła jej dłoni."
