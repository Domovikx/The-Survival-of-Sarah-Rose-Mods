# -*- encoding: utf-8 -*-
# Arc: VargaMarionPath | Scene: MarionPath2

translate pl strings:

    old "A crown her family still wore, to this day."
    new "Korona, którą jej rodzina wciąż nosiła, do dziś."

    old "A few did not attend."
    new "Niektórzy nie przybyli."

    old "A child, born from her family and his. The final seal that would forever link their houses."
    new "Dziecko urodzone z ich rodzin. Ostateczna pieczęć, która na zawsze połączy ich rody."

    old "A child that would guarantee peace and stability."
    new "Dziecko, które zagwarantuje pokój i stabilność."

    old "A growing confidence in himself."
    new "Rozrastająca się pewność siebie."

    old "A claim that Oliver could use as a pretext to take offense."
    new "Powiedzenie, które Oliver mógłby wykorzystać jako pretekst do urazy."

    old "A lot of trade goes through it, and he taxes it."
    new "Przez nie przechodzi sporo handlu, a on od tego pobiera podatki."

    old "Summon Oliver to court"
    new "Zwołaj Oliviera na sąd"

    old "Do not punish Oliver"
    new "Nie karć Olivera"

    old "Accept her invitation"
    new "Akceptuj jej zaproszenie"

    old "Reject her invitation"
    new "Odmów jej zaproszenia"

    old "Stand up to him"
    new "Stój przed nim"

    old "Lower your gaze"
    new "Spuść wzrok"

    old "Submit to Marion"
    new "Poddać się Marion"

    old "Resist Marion"
    new "Opór Marion"
