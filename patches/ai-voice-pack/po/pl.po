msgctxt "speaker:Narrator"
msgid "She moved her fingers through her hair."
msgstr "Przesunęła palcami przez włosy."

msgctxt "speaker:Narrator"
msgid "It was a mess, she concluded."
msgstr "To był bałagan – stwierdziła."

msgctxt "speaker:Narrator"
msgid "Sarah did the best she could to get cleaned up again."
