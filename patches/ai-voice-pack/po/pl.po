msgctxt "speaker:Marion"
msgid "So he will order his son to court."
msgstr "Więc rozkaże swojemu synowi udać się na dwór."

msgctxt "speaker:Marion"
msgid "He will not directly confront the Crown."
msgstr "On nie skonfrontuje się bezpośrednio z Koroną."

msgctxt "speaker:Marion"
msgid "We can speak more on the matter later."
msgstr "Możemy porozmawiać o tej sprawie później."

msgctxt "speaker:Marion"
msgid "For now, I have some other duties to attend to as well."
msgstr "Na razie mam też inne obowiązki do wykonania."

msgctxt "speaker:Marion"
msgid "I will be back tonight."
msgstr "Wrócę dziś wieczorem."

msgctxt "speaker:Narrator"
msgid "Sarah knew why."
msgstr "Sarah wiedziała dlaczego."

msgctxt "speaker:Narrator"
msgid "He was her husband, after all."
msgstr "W końcu był przecież jej mężem."

msgctxt "speaker:Narrator"
