msgctxt "speaker-name"
msgid "Orwen"
msgstr ""

#. emotion: Reflectively thoughtful
msgctxt "speaker:Narrator"
msgid "Orwen nodded."
msgstr ""

#. emotion: Curiously observing
msgctxt "speaker:Narrator"
msgid "Orwen sighed."
msgstr ""

#. emotion: In a tender, supportive embrace
msgctxt "speaker:Narrator"
msgid "Orwen supressed his sobs and nodded, hugging his father closer than before."
msgstr ""

#. emotion: In a hushed, awestruck tone
msgctxt "speaker:Narrator"
msgid "Orwen was the first to stumble out from his hiding spot."
msgstr ""

#. emotion: Delicately intrigued
msgctxt "speaker:Narrator"
msgid "Orwen was the one who handed her a book, titled 'The Tale of Roderic The Brave'."
msgstr ""

#. emotion: Nervously hesitant
msgctxt "speaker:Narrator"
msgid "Orwen, her son, older by a few years than his sister and pretending to be stronger than he was, held back for a moment."
msgstr ""

msgctxt "speaker-name"
msgid "Oryon"
msgstr ""

#. emotion: Curiously observing
msgctxt "speaker:Narrator"
msgid "Oryon nodded."
msgstr ""

#. emotion: Playfully teasing
msgctxt "speaker:Narrator"
msgid "Oryon smiled."
msgstr ""

#. emotion: Curiously observing
msgctxt "speaker:Sarah"
msgid "Other boys always played soldier and wanted to fight, but Thomas always looked kind of weird with a sword."
