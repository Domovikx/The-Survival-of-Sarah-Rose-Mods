msgctxt "speaker:Narrator"
msgid "She could see his eyes still hungry."
msgstr "Ella podía ver que sus ojos seguían hambrientos."

msgctxt "speaker:Narrator"
msgid "Alaric nodded and threw the coin over at Hugh, who grasped at it desperately."
msgstr "Aláric asintió y le lanzó la moneda a Hugo, quien la atrapó con desesperación."

msgctxt "speaker:Hugh"
