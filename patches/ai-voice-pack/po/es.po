msgctxt "speaker:Narrator"
msgid "His powerful hand wrapped around her hair again, snapping her head back."
msgstr "¡Su poderosa mano volvió a envolverle el cabello, tirando de su cabeza hacia atrás!"

msgctxt "speaker:Atilla"
msgid "Answer me!"
msgstr "¡Respóndeme!"

msgctxt "speaker:Narrator"
msgid "His voice boomed, powerful, deep."
msgstr "Su voz retumbó, potente y profunda."

msgctxt "speaker:Atilla"
msgid "Yes what?"
msgstr "¿Sí, qué?"

msgctxt "speaker:Sarah"
msgid "Yes, I'll marry you! I'll be your wife!"
msgstr "¡Sí, me casaré contigo! ¡Seré tu esposa!"

msgctxt "speaker:Narrator"
