msgstr "No lo sé. Quizás..."

msgctxt "speaker:Garret"
msgid "I don't know..."
msgstr "No lo sé..."

msgctxt "speaker:Jaeid"
msgid "I don't know..."
msgstr "No lo sé..."

msgctxt "speaker:Sarah"
msgid "I don't know...I guess it just...never happened."
msgstr "No lo sé... supongo que simplemente... nunca ocurrió."

msgctxt "speaker:Sarah"
msgid "I don't know...I have to think."
msgstr "No lo sé... tengo que pensarlo."

msgctxt "speaker:Marius"
