msgctxt "speaker:Narrator"
msgid "The pain that she felt was dulled."
msgstr "El dolor que sentía se había atenuado."

msgctxt "speaker:Narrator"
msgid "The pain very quickly faded, giving way to pleasure."
msgstr "El dolor se desvaneció muy rápidamente, dando paso al placer."

msgctxt "speaker:Narrator"
