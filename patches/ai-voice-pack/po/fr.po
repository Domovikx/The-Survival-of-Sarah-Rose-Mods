msgid "Sarah forced herself to nod."
msgstr "Sarah se força à hocher la tête."

msgctxt "speaker:Sarah"
msgid "Yeah...maybe..."
msgstr "Oui... peut-être..."

msgctxt "speaker:Narrator"
msgid "Dalia smiled."
msgstr "Dalía sourit."

msgctxt "speaker:Dalia"
msgid "Good! Now, let's get you dressed up."
msgstr "Bien ! Maintenant, allons te préparer."

msgctxt "speaker:Sarah"
msgid "Dressed up?"
