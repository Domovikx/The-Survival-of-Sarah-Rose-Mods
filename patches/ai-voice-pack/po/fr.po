msgstr "Sarah entendit sa propre voix s'estomper lentement."

msgctxt "speaker:Narrator"
msgid "Samayra looked up from the desk."
msgstr "Samayra leva les yeux du bureau."

msgctxt "speaker:Samayra"
msgid "Don't say that."
msgstr "Ne dis pas ça."

msgctxt "speaker:Sarah"
msgid "But it's true."
msgstr "Mais c'est vrai."

msgctxt "speaker:Samayra"
msgid "It's not true."
msgstr "Ce n'est pas vrai."

msgctxt "speaker:Samayra"
msgid "You always..."
