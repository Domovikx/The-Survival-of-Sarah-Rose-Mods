msgctxt "speaker:Maeiv"
msgid "Please, proceed."
msgstr "Пожалуйста, приступайте."

msgctxt "speaker:Thomas"
msgid "Please, promise me."
msgstr "Пожалуйста, обещай мне."

msgctxt "speaker:Narrator"
msgid "Please, she begged him with her eyes, her mouth and her body, finish."
msgstr "Пожалуйста, умоляла она его глазами, ртом и телом, кончай."

msgctxt "speaker:Narrator"
msgid "Please, she prayed to herself, don't make me kill him."
msgstr "Пожалуйста, — взмолилась она про себя, — не заставляй меня убивать его."

msgctxt "speaker:Narrator"
