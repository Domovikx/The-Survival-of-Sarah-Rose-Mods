msgid "Control. Poise. Discipline."
msgstr "Контроль. Выдержка. Дисциплина."

#. emotion: In a tone of awe mixed with fear
msgctxt "speaker:King-On-The-Outside"
msgid "Controlled by those Demons who you would worship as Gods."
msgstr "Управляемая теми Демонами, которых ты почитаешь как Богов."

msgctxt "menu"
msgid "Convince Alaric"
msgstr "Переубедить Аларика"

#. emotion: Earnestly pleading, with hope
msgctxt "speaker:Carolyn"
msgid "Convince Gilead that you are what he wants you to be. Gain the support of his armies."
msgstr "Убеди Гилеада, что ты та, кем он хочет тебя видеть. Заручись поддержкой его армий."

msgctxt "menu"
msgid "Convince him to support you"
msgstr "Убедить его поддержать тебя"

#. emotion: Curiously observing
msgctxt "speaker:Sarah"
