msgstr "Что насчёт него?"

msgctxt "speaker:Alaric"
msgid "What about it?"
msgstr "Что с ней?"

msgctxt "speaker:Hecate"
msgid "What about it?"
msgstr "Что с ней?"

msgctxt "speaker:Maeiv"
msgid "What about it?"
msgstr "Что с ней?"

msgctxt "speaker:Sarah"
msgid "What about it?"
msgstr "Что с ней?"

msgctxt "speaker:Sarah"
msgid "What about me?"
