msgstr "Встретиться с Гарретом"

msgctxt "menu"
msgid "Meet with Kate"
msgstr "Встретиться с Кейт"

msgctxt "menu"
msgid "Meet with Lord Edmond"
msgstr "Встретиться с лордом Эдмондом"

msgctxt "menu"
msgid "Meet with Maeiv"
msgstr "Встретиться с Мейв"

msgctxt "menu"
msgid "Meet with Queen Maeiv"
msgstr "Встретиться с королевой Мейв"

