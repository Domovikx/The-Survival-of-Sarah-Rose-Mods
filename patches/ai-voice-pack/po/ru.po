msgstr "Что ты делаешь?!"

msgctxt "speaker:Sigmund"
msgid "What are you doing?!"
msgstr "Что ты делаешь?!"

msgctxt "speaker:Sarah"
msgid "What are you doing…?"
msgstr "Что ты делаешь…?"

msgctxt "speaker:Alaric"
msgid "What are you going to do about it?"
msgstr "И что ты собираешься с этим делать?"

msgctxt "speaker:Duke Antonio"
msgid "What are you going to do about it?"
msgstr "И что ты собираешься с этим делать?"

msgctxt "speaker:Vaelen"
msgid "What are you going to do?"
msgstr "Что ты собираешься делать?"

msgctxt "speaker:Sarah"
msgid "What are you gonna do?"
msgstr "Что ты собираешься делать?"

msgctxt "speaker:Sarah"
msgid "What are you in for."
msgstr "За что ты здесь."

msgctxt "speaker:Carolyn"
