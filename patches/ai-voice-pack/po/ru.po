msgstr "А как же Розанна?"

msgctxt "speaker:Sarah"
msgid "What about Thomas?"
msgstr "А как же Томас?"

msgctxt "speaker:Ephraim"
msgid "What about Vaelen, he showing up?"
msgstr "А Вэлен, он придёт?"

msgctxt "speaker:Kate"
msgid "What about Vaelen? Hasn't he told you anything?"
msgstr "А Ваэлен? Он тебе ничего не говорил?"

msgctxt "speaker:Sarah"
msgid "What about another girl?"
msgstr "А как насчёт ещё одной девочки?"

msgctxt "speaker:Sarah"
msgid "What about her life?"
msgstr "Что насчёт её жизни?"

msgctxt "speaker:Alaric"
msgid "What about him?"
msgstr "Что насчёт него?"

msgctxt "speaker:Marion"
