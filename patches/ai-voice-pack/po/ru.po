msgid "I...I did?"
msgstr "Я... сделала?"

msgctxt "speaker:Sarah"
msgid "I...I didn't come here! Release me!"
msgstr "Я... я не приходила сюда! Отпусти меня!"

msgctxt "speaker:Sarah"
msgid "I...I didn't get that yet, sorry."
msgstr "Я...я ещё не взяла его, прости."

msgctxt "speaker:Sarah"
msgid "I...I didn't know you thought that."
msgstr "Я...я не знала, что вы так думаете."

