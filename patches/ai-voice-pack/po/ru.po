msgid "Hey!"
msgstr "Эй!"

#. emotion: Curiously observing
msgctxt "speaker:Guard"
msgid "Hey!"
msgstr "Эй!"

#. emotion: Curiously observing
msgctxt "speaker:Jasmine"
msgid "Hey!"
msgstr "Эй!"

#. emotion: Curiously observing
msgctxt "speaker:Kate"
msgid "Hey!"
msgstr "Эй!"

#. emotion: Curiously observing
msgctxt "speaker:Kim"
msgid "Hey!"
msgstr "Эй!"

#. emotion: Curiously observing
msgctxt "speaker:Lily"
msgid "Hey!"
msgstr "Эй!"

#. emotion: Curiously observing
