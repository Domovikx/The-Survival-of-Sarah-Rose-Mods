msgstr "{#quick_page}Q"

msgctxt "speaker:Narrator"
msgid "{i}Composure{/i}. She reminded herself in the voice of her father."
msgstr "{i}Спокойствие{/i}. Напомнила она себе голосом отца."

msgctxt "speaker:Narrator"
msgid "{i}It tore her heart apart, and still she forced herself to watch. Don't look away from what you cause, she told herself.{/i}"
msgstr "{i}Это разрывало её сердце на части, и всё же она заставляла себя смотреть. Не отворачивайся от того, что ты причиняешь, сказала она себе.{/i}"

msgctxt "speaker:Narrator"
msgid "{i}Who's escorting whom? Sarah thought to herself, as she corrected Varga a few times on the route to the library.{/i}"
msgstr "{i}Кто кого сопровождает? — подумала Сара, несколько раз поправив Варгу по пути в библиотеку.{/i}"
