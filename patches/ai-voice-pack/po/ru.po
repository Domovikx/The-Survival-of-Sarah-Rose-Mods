msgid "Please...end this horror."
msgstr "Пожалуйста...положи конец этому ужасу."

msgctxt "speaker:Sarah"
msgid "Please...just let me go..."
msgstr "Пожалуйста... просто отпустите меня..."

msgctxt "speaker:Sarah"
msgid "Please...more..."
msgstr "Пожалуйста... ещё..."

msgctxt "speaker:Sarah"
msgid "Please...show me where it is. I just want to see my home again."
msgstr "Пожалуйста... покажи мне, где она. Я просто хочу снова увидеть свой дом."

msgctxt "speaker:Sarah"
msgid "Please...take me..."
