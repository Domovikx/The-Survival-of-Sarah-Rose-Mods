msgctxt "speaker:Narrator"
msgid "Cassius turned to Dio."
msgstr "Кассий повернулся к Дио."

msgctxt "speaker:Narrator"
msgid "Cassius turned to Kate."
msgstr "Кассий повернулся к Кейт."

msgctxt "speaker:Narrator"
