msgctxt "speaker:Narrator"
msgid "The Duke sighed again."
msgstr "Il Duca sospirò di nuovo."

msgctxt "speaker:Duke Antonio"
msgid "I am rather destitute, I am afraid."
msgstr "Temo di essere piuttosto indigente."

