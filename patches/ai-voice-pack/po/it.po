msgctxt "speaker:Sarah"
msgid "Enough."
msgstr "Basta."

msgctxt "speaker:Sarah"
msgid "Save your false apologies for another."
msgstr "Riserva le tue false scuse per qualcun altro."

msgctxt "speaker:Sarah"
msgid "I have come for your support."
msgstr "Sono venuta per il tuo sostegno."

msgctxt "speaker:Duke Antonio"
