msgid "I know what you struggle with."
msgstr ""

#. uid: fc6ef31597c36b2779d1e0b0b8cb72de
msgctxt "speaker:Sarah"
msgid "I know where it is."
msgstr ""

#. uid: 9877c7d68cf7f01158387bb35c4ca422
msgctxt "speaker:Maeiv"
msgid "I know where my hand is, silly."
msgstr ""

#. uid: 5eea20f552ad9f338ffc3824c13760c7
msgctxt "speaker:Varga"
msgid "I know who you are."
