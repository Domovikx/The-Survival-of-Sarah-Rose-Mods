#. uid: 6f3304ee43897de534f39dbda8edd583
msgctxt "speaker:Advisor"
msgid "Too ambitious?"
msgstr ""

#. uid: 320c9a132c58e33d207a1f32e42ba1cf
msgctxt "speaker:Narrator"
msgid "Too arrogant to apologize, the Shah had blamed the prince."
