msgid "No! That's not what this is at all!"
msgstr ""

#. uid: 29cddbd4bfebb85b610abf9fb4442023
msgctxt "speaker:Sarah"
msgid "No! Wait!"
msgstr ""

#. uid: 9c5f3b6a9f55cfeb3eec11e711d25784
msgctxt "speaker:Sarah"
msgid "No! You can't! That's...that's not fair..."
msgstr ""

#. uid: 80ae1a66dd3b3373521e77c57177f637
msgctxt "speaker:Sarah"
msgid "No, Captain, I just thought I'd check to see if everything was going well."
msgstr ""

#. uid: 289e67addd499415797751f15574cdd2
