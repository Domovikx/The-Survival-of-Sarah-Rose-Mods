#. uid: dbaf0c0e4dd337b55fce4fb34a08125b
msgctxt "speaker:Hecate"
msgid "Torture, both practical and magical in nature."
msgstr ""

#. uid: e9e829ebdb0f2dc40a76794ddbe3d084
msgctxt "speaker:Razaphel"
msgid "Tortures, to be more exact."
msgstr ""

#. uid: c9094075e9a89eb039bf8fa6e6a54623
msgctxt "speaker:Sarah"
msgid "Totem?"
msgstr ""

#. uid: ca1289dad5087e4e421c1721191a8cd8
msgctxt "speaker:Narrator"
msgid "Touch the stone and she would be free. Sarah considered it."
msgstr ""

#. uid: f8d32ba2873bba61c975cd9d07f10d15
msgctxt "speaker:Kate"
msgid "Touch yourself, I know you've been dying to."
