msgid "The words didn't surprise Sarah."
msgstr ""

#. uid: a83716238031e3cf4ea9425b67691990
msgctxt "speaker:Narrator"
msgid "The words failed her."
msgstr ""

#. uid: 514bd12c6ec27496b03e93932a51416b
