msgid "Too much to speak of, would that I could, but we must live fate, not speak it."
msgstr ""

#. uid: 3fb2d71e78d27cd031b3c5fb03f3e0e6
msgctxt "speaker:Sarah"
msgid "Too much."
msgstr ""

#. uid: ce3720f52db2576d3edc737b0de4c36b
