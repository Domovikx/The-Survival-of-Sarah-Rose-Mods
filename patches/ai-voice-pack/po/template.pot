#. uid: 5cd2dd0e8c7a9f9163d9669f7fefc99f
msgctxt "speaker:Captain Belmont"
msgid "I know."
msgstr ""

#. uid: 5cd2dd0e8c7a9f9163d9669f7fefc99f
msgctxt "speaker:Kate"
msgid "I know."
msgstr ""

#. uid: 5cd2dd0e8c7a9f9163d9669f7fefc99f
msgctxt "speaker:Lily"
msgid "I know."
msgstr ""

#. uid: 5cd2dd0e8c7a9f9163d9669f7fefc99f
msgctxt "speaker:Sarah"
msgid "I know."
msgstr ""

#. uid: 8c7bcf4c1c80cb96279bcf923f38a91c
msgctxt "speaker:Kate"
msgid "I know. And I'm still asking."
msgstr ""

#. uid: cdbb00d8bc76b68d5a06ceb2bcc8e2e8
msgctxt "speaker:Kate"
msgid "I know. I told them as much, but they...they just didn't listen."
msgstr ""

#. uid: eef8eb81537ad3b72d26a9cdd2b7817c
msgctxt "speaker:Alaric"
msgid "I know. I'll owe you."
msgstr ""

#. uid: 9a60806167cca0bca795fb70a17d1fd7
msgctxt "speaker:Sarah"
msgid "I know. I'm choosing to do this."
msgstr ""

#. uid: 8d0d1a3d57c0a3ee685236b509b7a207
msgctxt "speaker:Sarah"
msgid "I know. You mean a lot to me too."
msgstr ""

#. uid: 3d153b21b5a766b4016d19b5a3dc8910
msgctxt "speaker:Samayra"
msgid "I know. You're a good person, Sarah."
msgstr ""

#. uid: 0e720fd121ec79ab07eb5252d8a71582
msgctxt "speaker:Atilla"
msgid "I know..."
msgstr ""

#. uid: 0e720fd121ec79ab07eb5252d8a71582
msgctxt "speaker:Kate"
msgid "I know..."
msgstr ""

#. uid: 0e720fd121ec79ab07eb5252d8a71582
msgctxt "speaker:Sarah"
msgid "I know..."
