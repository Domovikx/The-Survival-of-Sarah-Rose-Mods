#. uid: 8d9820e675ee31e48d92f8dd6e8e79b3
msgctxt "speaker:Alaric"
msgid "Too big huh?"
msgstr ""

#. uid: eef6fb269347b3a323022dce69a4cf46
msgctxt "speaker:Razaphel"
msgid "Too clever for his own good. Ambitious to the point of sin. Always pretending."
msgstr ""

#. uid: 59cc38288bd7a12c5ebae67e2364363d
msgctxt "speaker:Narrator"
msgid "Too close for him to swing the blade, he desperately tried to twist his body, but each knew it was too late."
msgstr ""

#. uid: d8df2b88c706918253b53d4c48aecbc6
msgctxt "speaker:Narrator"
msgid "Too close to swing, she drew her blade past him as she dodged."
msgstr ""

#. uid: 562450c4a3b850b37e2ec32f5add89d4
msgctxt "speaker:Narrator"
msgid "Too close, neither could properly swing their blade at the other."
msgstr ""

#. uid: 841c077aba9a350a63e67490d0adffda
msgctxt "speaker:Narrator"
msgid "Too dangerous, he had warned her."
msgstr ""

#. uid: 680137bffb2025de18f4d14373813f90
msgctxt "speaker:Narrator"
msgid "Too distracted for grief."
