msgid "A reminder of just how long this house had sat empty."
msgstr ""

#. uid: 88aab608d4af2a309d8fdae0a25306a8
msgctxt "speaker:Narrator"
msgid "A reminder that would last for a while."
msgstr ""

#. uid: e9971dbb97eec01428cbdc258f8ad1a7
msgctxt "speaker:Sarah"
msgid "A reminder to them, and to myself, about where each stands."
msgstr ""

#. uid: e8ee6b6e4642469d0064ec6ac65d4392
msgctxt "speaker:Narrator"
msgid "A reply, but not an answer."
msgstr ""

#. uid: 089dc3408d9b467795fc313fd8001b4e
msgctxt "speaker:Kate"
msgid "A report from the authorities."
msgstr ""

#. uid: 6b1dfb65b31b7c056a3339cd96164ccf
msgctxt "speaker:Narrator"
msgid "A repressed sobbing sound slipped out from Kate."
msgstr ""

#. uid: 65c16e5151f2c685c0a372dceaeb88a7
msgctxt "speaker:Jaeid"
msgid "A request can be denied, can it not, Great Khan?"
