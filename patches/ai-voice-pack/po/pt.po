msgstr "Entre."

msgctxt "speaker:Narrator"
msgid "The door slowly opened."
msgstr "A porta se abriu lentamente."

msgctxt "speaker:Narrator"
msgid "Alaric lingered in the doorway."
msgstr "Aláric demorou-se na porta."

msgctxt "speaker:Narrator"
msgid "She had been hoping he'd come by."
msgstr "Ela tinha esperado que ele aparecesse."

msgctxt "speaker:Sarah"
msgid "You're all done playing the hero?"
msgstr "Você já terminou de brincar de herói?"

msgctxt "speaker:Alaric"
msgid "You still on about that?"
msgstr "Você ainda está falando sobre isso?"

msgctxt "speaker:Narrator"
