msgctxt "speaker:Narrator"
msgid "Sarah watched as Kate stared off across the square, her head swaying from side to side."
msgstr "Sarah observou enquanto Kate olhava para o outro lado da praça, balançando a cabeça de um lado para o outro."

msgctxt "speaker:Sarah"
