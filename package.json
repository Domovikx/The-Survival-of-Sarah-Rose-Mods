{
  "name": "tssr-mods",
  "private": true,
  "type": "module",
  "description": "The Survival of Sarah Rose — мод-патчи (AI Voice Pack + переводы): пайплайн и лендинг",
  "scripts": {
    "prepare": "husky",
    "extract": "node .opencode/skills/renpy-extract/extract_texts.mts extract",
    "extract-builtins": "node .opencode/skills/renpy-extract/extract_texts.mts extract-builtins",
    "verify": "node .opencode/skills/renpy-extract/extract_texts.mts verify",
    "dedup": "node .opencode/skills/renpy-dedup/dedup_translations.mts",
    "dedup-dry": "node .opencode/skills/renpy-dedup/dedup_translations.mts --dry-run",
    "clearcache": "node .opencode/skills/renpy-clear-cache/clear_cache.mts",
    "tlstat": "node .opencode/skills/list-translation-files/list_translation_files.mts",
    "tlaudit": "node .opencode/skills/renpy-audit/review_translations.mts",
    "potgen": "node .opencode/skills/renpy-po/potgen.mts",
    "po:update": "node .opencode/skills/renpy-po/po_update.mts",
    "po:prefill": "node .opencode/skills/renpy-po/prefill.mts",
    "speakers:audit": "node patches/ai-voice-pack/tools/generate/scripts/speaker_map.mts sync",
    "speakers:audit:emit": "node patches/ai-voice-pack/tools/generate/scripts/speaker_map.mts sync --emit",
    "speakers:check": "node patches/ai-voice-pack/tools/generate/scripts/speaker_map.mts check",
    "test:speakers": "node --test patches/ai-voice-pack/tools/generate/scripts/speaker_map.test.mts",
    "refs:add": "node patches/ai-voice-pack/tools/generate/scripts/add_candidate.mts",
    "test:refs": "node --test patches/ai-voice-pack/tools/generate/scripts/clean_refs.test.mts patches/ai-voice-pack/tools/generate/scripts/add_candidate.test.mts",
    "typecheck": "tsc --noEmit",
    "casts:mts": "node patches/ai-voice-pack/tools/generate/scripts/cast_mts.mts",
    "test:casts": "node --test patches/ai-voice-pack/tools/generate/scripts/cast_mts.test.mts",
    "build:pack": "python patches/ai-voice-pack/tools/build/build_pack.py",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "spell": "cspell lint \"**/*.md\" --no-progress",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,mts,cts}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,css,html,md,yml,yaml}": [
      "markdownlint-cli2 --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@cspell/dict-ru_ru": "^2.3.4",
    "@types/node": "^26.6.5",
    "cspell": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.23.3",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
