/**
 * Разовый ремонт бакета «добавлено» полной судейской волны: 21 реальный
 * дефект из 294 разобранных (остальное — FP-слововыбор, не трогаем).
 * 2026-11-07. Запуск: node tmp/fix_bucketC.mts
 */
import { readFileSync } from "node:fs";

import { parsePo, renderPo, writePoAtomic } from "../.opencode/skills/renpy-po/po_core.mts";

const PO = "patches/ai-voice-pack/po/ru.po";
const text = readFileSync(PO, "utf-8").replace(/\r\n/g, "\n");
const entries = parsePo(text).filter((e) => e.msgid);
const header = text.split("\n\n")[0].split("\n");

// Полные замены.
const full = new Map<number, string>([
  [2213, "Сара пытается вырваться, но перед чудовищной силой этих мужчин она бессильна. Они расходятся и прижимают её ноги к кровати."],
  [7566, "Отказаться, отругать его"],
  [17784, "Ты уставилась, блондинка."],
  [23445, "Сара заплакала, продолжая сосать его."],
  [25578, "Калеб говорил мне, что прошло уже так много времени с тех пор, как я его сосала."],
  [27563, "Затем оно сомкнулось."],
  [30296, "Я однажды отсосала старому моряку"],
  [33130, "Спасибо, что приняли нас."],
  [34958, "Тебе понравилось?"],
  [37368, "Просунув язык девушке, Сара почувствовала на нём вкус Самайры."],
  [37593, "Сара почувствовала, как её руки дрожат."],
  [47381, "Он колебался. Что-то его сдерживало."],
  [48326, "Она хотела."],
  [55251, "Сара услышала и увидела достаточно."],
  [68077, "Она наслаждалась этим."],
  [68449, "Я буду брать тебя."],
]);
// Точечные подстрочные правки (полный текст не перезаписываем).
const subs = new Map<number, Array<[string, string]>>([
  [17537, [["когда вы заканчивали", "когда ты заканчивала"]]],
  [43530, [["Незадолго до этого", "Вскоре после этого"]]],
  [45825, [["Сними с него одежду, и он тебе всё даст", "Доведи его до конца, и он тебе всё даст"]]],
  [57960, [["твёрдый член впился", "твёрдое дерево впилось"]]],
  [61770, [["он чувствовал", "она чувствовала"]]],
]);

let n = 0;
for (const [i, val] of full) {
  const e = entries[i];
  if (!e) {
    console.log(`[${i}] НЕТ СТРОКИ`);
    continue;
  }
  console.log(`[${i}] было: ${e.msgstr.slice(0, 70)}`);
  e.msgstr = val;
  n++;
}
for (const [i, reps] of subs) {
  const e = entries[i];
  if (!e) {
    console.log(`[${i}] НЕТ СТРОКИ`);
    continue;
  }
  let t = e.msgstr;
  for (const [a, b] of reps) t = t.split(a).join(b);
  if (t === e.msgstr) console.log(`[${i}] ПОДСТРОКА НЕ НАЙДЕНА — пропуск`);
  else {
    console.log(`[${i}] подстрока: ${reps[0][0]} → ${reps[0][1]}`);
    e.msgstr = t;
    n++;
  }
}
writePoAtomic(PO, renderPo(entries, header));
console.log(`исправлено: ${n}`);
