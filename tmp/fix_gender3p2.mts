/**
 * Разовый ремонт, пакет №2 (дополнение к fix_gender3p): доводка после
 * E2E-верификации 2026-11-08.
 * - Xanthippe = М по EN-тексту игры («his chair/«he took») → откат двух
 *   моих ошибочных правок + женские формы в наррации о Ксан = реальный брак;
 * - остатки триажа: [11230] субъект, [29114] выдуманное «картина»,
 *   [47831] субъект-объект, [47868] согласование.
 * Запуск: node tmp/fix_gender3p2.mts
 */
import { readFileSync } from "node:fs";

import { parsePo, renderPo, writePoAtomic } from "../.opencode/skills/renpy-po/po_core.mts";

const PO = "patches/ai-voice-pack/po/ru.po";
const text = readFileSync(PO, "utf-8").replace(/\r\n/g, "\n");
const entries = parsePo(text).filter((e) => e.msgid);
const header = text.split("\n\n")[0].split("\n");

const subs = new Map<number, Array<[string, string]>>([
  // Откат ошибочных правок (EN игры: Xanthippe = he).
  [52078, [["Я могла бы взять тебя в ученицы! Я могла бы научить", "Я мог бы взять тебя в ученицы! Я мог бы научить"]]],
  [66605, [["И Зан знала риск, на который она пошла, когда взяла тебя", "И Зан знал риск, на который он пошёл, когда взял тебя"]]],
  // Женские формы в наррации о Ксан (Xan = he по EN) — реальный брак.
  [51714, [["Ксантиппа села в кресло", "Ксантиппа сел в кресло"]]],
  [51825, [["Зант обернулась к Саре", "Зант обернулся к Саре"]]],
  [51847, [["Ксант на мгновение замерла, собираясь", "Ксант на мгновение замер, собираясь"]]],
  [52187, [["Ксан с благодарностью кивнула", "Ксан с благодарностью кивнул"]]],
  [52348, [["Ксан была занята тем, что перебирала стопку книг", "Ксан был занят тем, что перебирал стопку книг"]]],
  [52372, [["Ксантиппа замолчала. Она отложила книги и попыталась", "Ксантиппа замолчал. Он отложил книги и попытался"]]],
  [52665, [["Ксантиспа стояла в стороне", "Ксантиспа стоял в стороне"]]],
  [52779, [["Ксан уставилась вдаль", "Ксан уставился вдаль"]]],
  [53031, [["Ксант хмыкнула", "Ксант хмыкнул"]]],
  [53041, [["Ксант на мгновение замолчала, словно пытаясь", "Ксант на мгновение замолчал, словно пытаясь"]]],
  [53624, [["Ксантиппа посмотрела на Сару, а затем снова устремила взгляд", "Ксантиппа посмотрел на Сару, а затем снова устремил взгляд"]]],
  [53808, [["Зант начала уходить, пока Сара её не остановила", "Зант начал уходить, пока Сара его не остановила"]]],
  [53889, [["Зант снова повернулась к Саре", "Зант снова повернулся к Саре"]]],
  [54008, [["Зант ходила туда-сюда", "Зант ходил туда-сюда"]]],
  [54203, [["Ксант сделала ещё один шаг вперёд", "Ксант сделал ещё один шаг вперёд"]]],
  // Доводка триажа.
  [11230, [["ей не потребовалось много времени, чтобы довести себя до конца", "ему не потребовалось много времени, чтобы довести себя до конца"]]],
  [29114, [["картина переходила из рук в руки", "произведение переходило из рук в руки"]]],
  [47831, [["она почувствовала, как она наклонилась к кончику его члена", "она почувствовала, как он притягивал её к кончику своего члена"]]],
  [47868, [["Ещё один шлепок прозвучала", "Ещё один шлепок прозвучал"]]],
]);

let fixed = 0;
let missing = 0;
for (const [i, reps] of subs) {
  const e = entries[i];
  if (!e) {
    console.log(`[${i}] НЕТ СТРОКИ`);
    missing++;
    continue;
  }
  let t = e.msgstr;
  for (const [a, b] of reps) {
    if (!t.includes(a)) {
      console.log(`[${i}] НЕ НАЙДЕНО: «${a.slice(0, 55)}»`);
      missing++;
    }
    t = t.split(a).join(b);
  }
  if (t !== e.msgstr) {
    e.msgstr = t;
    fixed++;
  }
}
writePoAtomic(PO, renderPo(entries, header));
console.log(`исправлено записей: ${fixed}, проблем: ${missing}`);
