/**
 * site_l10n_gen.mts — генератор locales/{de,es,fr,it,ja,ko,pl,pt,zh}.json.
 * UI-строки — авторские переводы (терминология = мод zzz_ui: «патч» ≠ «игра»);
 * демо-фразы тянутся из po/<lang>.po по msgid (единый источник с игрой), при
 * отсутствии перевода — английский оригинал.
 * Запуск: node tmp/site_l10n_gen.mts
 */
import { readFileSync, writeFileSync } from "node:fs";

const en = JSON.parse(readFileSync("site/locales/en.json", "utf8"));

const PHRASE_IDS = en.demo.phrases.map((p: { text: string }) => p.text);

function parsePo(text: string): Map<string, string> {
  const map = new Map<string, string>();
  for (const b of text.split(/\n\n+/)) {
    const get = (kw: string): string | null => {
      const re = new RegExp(`^${kw} ("(?:[^"\\\\]|\\\\.)*"(?:\\n"(?:[^"\\\\]|\\\\.)*")*)`, "m");
      const m = re.exec(b);
      if (!m) return null;
      return m[1]!
        .split("\n")
        .map((l) => l.slice(1, -1))
        .join("")
        .replace(/\\n/g, "\n")
        .replace(/\\"/g, '"')
        .replace(/\\\\/g, "\\");
    };
    const id = get("msgid");
    const str = get("msgstr");
    if (id !== null && str !== null && !map.has(id)) map.set(id, str);
  }
  return map;
}

/**
 * Приоритет: po (перевод игры — единый источник) > MANUAL_PHRASES (витрина
 * сайта: фразы из поздних сцен, вне демо-скоупа перевода) > EN-оригинал.
 */
function poPhrases(lang: string): string[] {
  let po: Map<string, string>;
  try {
    po = parsePo(readFileSync(`patches/ai-voice-pack/po/${lang}.po`, "utf8"));
  } catch {
    po = new Map();
  }
  return PHRASE_IDS.map((msgid: string, i: number) => {
    const t = po.get(msgid);
    return (t && t.trim()) || MANUAL_PHRASES[lang]?.[i] || msgid;
  });
}

