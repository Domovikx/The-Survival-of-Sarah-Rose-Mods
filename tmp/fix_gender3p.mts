]);

let fixed = 0;
let missing = 0;
for (const [i, reps] of subs) {
  const e = entries[i];
  if (!e) {
    console.log(`[${i}] НЕТ СТРОКИ`);
    missing++;
    continue;
  }
  let t = e.msgstr;
  for (const [a, b] of reps) {
    if (!t.includes(a)) {
      console.log(`[${i}] НЕ НАЙДЕНО: «${a.slice(0, 50)}» — пропуск пары`);
      missing++;
    }
    t = t.split(a).join(b);
  }
  if (t !== e.msgstr) {
    e.msgstr = t;
    fixed++;
  }
}
writePoAtomic(PO, renderPo(entries, header));
console.log(`исправлено записей: ${fixed}, проблем: ${missing}`);
