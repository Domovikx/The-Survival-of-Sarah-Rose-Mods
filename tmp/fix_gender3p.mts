  [57311, [["что он спал на удивление крепко", "что она спала на удивление крепко"]]],
  [57459, [["он не хотел слишком сильно её давить", "она не хотела слишком сильно её давить"], ["Самайра заговорила бы с ним", "Самайра заговорила бы с ней"]]],
