/**
 * Разовый ремонт: 31 строка из36 упрямых (судья --retrans не прошёл, СТАРОЕ
 * осталось) — не та строка/вклейка/выдумка. Переводы написаны агентом по
 * контексту ±2. 5 ложных флагов (адресат-род, [0], [28985], [43744]) — не
 * трогаем. Запуск: node tmp/fix_bad36.mts
 */
import { readFileSync } from "node:fs";

import { parsePo, renderPo, writePoAtomic } from "../.opencode/skills/renpy-po/po_core.mts";

const PO = "patches/ai-voice-pack/po/ru.po";
const text = readFileSync(PO, "utf-8").replace(/\r\n/g, "\n");
const entries = parsePo(text).filter((e) => e.msgid);
const header = text.split("\n\n")[0].split("\n");

const fixes = new Map<number, string>([
  [2147, "Марион покачал головой."],
  [3884, "Сара решила быть честной с Лили."],
  [7921, "Сара быстро выбежала из комнаты и хлопнула дверью за собой."],
  [11624, "Я знаю, что тебя держали в этой повозке довольно давно."],
  [12820, "Наконец, когда последнее покинуло её тело, Сара почувствовала, как Найдин вышла из неё."],
  [13679, "Сара смотрела, как они спорят друг с другом."],
  [14009, "Но как он мог их не любить? — подумала Сара. Его жизнь преобразилась: из низкого слуги он стал человеком, который был на ухе хана."],
  [16652, "Кейт успокоила её."],
  [20414, "Работяга."],
  [25707, "Ефраим согласился."],
  [25793, "Заметив эту сцену, Сара осознала, какая она влажная. Она скользнула одной рукой между ног и начала себя ласкать, продолжая сосать Калеба."],
  [25868, "Сара решила, что орку, возможно, потребуется убеждение."],
  [26781, "Вэлен в отчаянии поднял руки."],
  [27729, "В тот самый миг, когда Сара убила зверя, толпа солдат бросилась к ней с радостными криками — но, точнее, толп было две."],
  [29152, "Разве ты не пришла сюда в поисках багрового камня?"],
  [30287, "Спокойно. Правда в том, что ты убил молодого парня."],
  [31001, "Сара уверенно чувствовала, как Кейт наращивает темп, действуя всё сильнее и быстрее, с каждым толчком подгоняя её к безумию."],
  [32262, "Агент."],
  [40560, "Отказаться, начать осаду"],
  [41356, "Человеческая королева, замужем за орком и рожающая ему детей."],
  [46064, "Сара слушала молча."],
  [49038, "Альфред стоннул."],
  [50750, "От принцессы — к страннице, к жене Мариуса."],
  [51632, "Принцесса — бродяга. Жена старого Альфреда. Богатая вдова."],
  [55199, "Вместо того чтобы сопротивляться его оскорблению, она почувствовала, как её ладони упираются в холодные каменные стены переулка."],
  [58052, "Я начинаю беспокоиться о тебе, девочка."],
  [58157, "Отказаться помочь ему"],
  [58599, "Бывшая Розанна, как он сказал. Неудивительно: после падения все, кого не поработили, стали беженцами."],
  [58986, "Сара продолжала работать его членом, жаждая подчиниться ему."],
  [62465, "Осуждённый знает свой приговор. То, что он знает, не избавляет его от его исполнения."],
  [65718, "Это сказала она? Или Самайра?"],
]);

for (const [i, val] of fixes) {
  const e = entries[i];
  if (!e) {
    console.log(`[${i}] НЕТ СТРОКИ — пропуск`);
    continue;
  }
  console.log(`[${i}] было: ${e.msgstr.slice(0, 80)}`);
  e.msgstr = val;
}
writePoAtomic(PO, renderPo(entries, header));
console.log(`исправлено: ${fixes.size}`);
