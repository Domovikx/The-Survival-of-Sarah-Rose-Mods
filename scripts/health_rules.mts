/**
 * health_rules.mts — правила фонового контура БЕЗ побочных эффектов.
 *
 * Вынесено из `health_guard.mts` и `np_switch.mts`, чтобы правила можно было
 * проверить тестом: оба файла — скрипты с бесконечным циклом, импортировать их
 * в тест нельзя. Именно эти правила уже давали инциденты (2026-11-17/18):
 *   - страж гасил ЖИВОЙ прогон по «RAM свободно 4 %» и машина стояла 3 часа;
 *   - число слотов llama-server выбиралось по простою, и ошибка в нём стоила
 *     вдвое меньшей скорости перевода.
 */

/** Причины, по которым страж ОСТАНАВЛИВАЕТ прогон. Только температура GPU. */
export const STOP_REASON = "GPU_ЖАР";

/**
 * Почему останавливать нагрузку (или `undefined` — не останавливать).
 * RAM и «питание на потолке» — только пометки в CSV: падение до 4 % RAM это
 * пейджинг, а не авария, и убитый прогон хуже; 285–300 Вт — штатный режим
 * инференса. Останавливать по ним = потерять часы работы (проверено).
 */
export const stopReason = (notes: readonly string[]): string | undefined =>
  notes.find((n) => n.startsWith(STOP_REASON));

export interface NpRules {
  /** Порог простоя, минуты. */
  idleMin: number;
  /** Слотов, когда за ПК никого нет. */
  awayNp: number;
  /** Слотов, когда человек работает. */
  hereNp: number;
}

/**
 * Сколько параллельных слотов просить у llama-server.
 * Простой больше порога → `awayNp` (быстрее), иначе `hereNp` (мягче по RAM).
 * Отрицательный простой (датчик недоступен) трактуем как «человек за ПК».
 */
export const chooseNp = (idleSec: number, r: NpRules): number => (idleSec >= r.idleMin * 60 ? r.awayNp : r.hereNp);

/** Простой, при котором переключаемся на «ушёл» (секунды) — для логов. */
export const awayThresholdSec = (r: NpRules): number => r.idleMin * 60;
