/**
 * health_rules.mts — правила фонового контура в виде чистых функций.
 *
 * Назначение. `health_guard.mts` и `np_switch.mts` исполняются как процессы с
 * бесконечным циклом, поэтому импортировать их в тесты нельзя. Принятие решений
 * вынесено сюда: функции без побочных эффектов, покрыты health_rules.test.mts.
 *
 * Какие решения здесь зафиксированы:
 *   1. когда останавливать нагрузку (только перегрев GPU);
 *   2. сколько слотов запрашивать у llama-server в зависимости от простоя
 *      пользователя.
 *
 * Оба правила уже приводили к простоям при неверной трактовке (2026-11-17/18),
 * поэтому считаются контрактом и меняются только вместе с тестами.
 */

/** Единственная причина остановки прогона — перегрев GPU. */
export const STOP_REASON = "GPU_ЖАР";

/**
 * Почему останавливать нагрузку (или `undefined` — не останавливать).
 * Свободная память и предел мощности попадают в журнал как события, но не
 * прерывают прогон: падение до 4 % RAM означает пейджинг, а не отказ, а
 * 285–300 Вт — штатный режим инференса. Остановка по этим показателям приводила
 * к многочасовому простою (2026-11-17).
 */
export const stopReason = (notes: readonly string[]): string | undefined =>
  notes.find((n) => n.startsWith(STOP_REASON));

export interface NpRules {
  /** Порог простоя, минуты. */
  idleMin: number;
  /** Слотов, когда за ПК никого нет. */
  awayNp: number;
  /** Слотов, когда человек работает. */
  hereNp: number;
}

/**
 * Сколько параллельных слотов просить у llama-server.
 * Простой больше порога → `awayNp` (быстрее), иначе `hereNp` (мягче по RAM).
 * Отрицательный простой (датчик недоступен) трактуем как «человек за ПК».
 */
export const chooseNp = (idleSec: number, r: NpRules): number => (idleSec >= r.idleMin * 60 ? r.awayNp : r.hereNp);

/** Простой, при котором переключаемся на «ушёл» (секунды) — для логов. */
export const awayThresholdSec = (r: NpRules): number => r.idleMin * 60;
