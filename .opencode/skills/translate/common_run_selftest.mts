// Self-test гейта «вклейка соседа» на уже исправленных случаях (ru, 2026-11-06).
import { commonRun } from "./review_common_run.mts";

const cases: Array<[string, string, string]> = [
  [
    "С нарастающим голодом они оба принялись за еду, обмениваясь историями о своей жизни до того, как познакомились.",
    "Пока они ели свою порцию, каждый из них делился историями о своей жизни до того, как они познакомились.",
    "историями о своей жизни до того как",
  ],
  [
    "За столом сидел старик и шил на большом металлическом швейном станке, которым управлял ногами. На кончике его носа балансировала пара маленьких очков.",
    "На носу у него сидела пара маленьких очков.",
    "пара маленьких очков",
  ],
  [
    "Капитан заставил её не отводить от него глаз, пока она проглатывала последние капли его спермы.",
    "Она почувствовала стыд, обжигающий её лицо, всё так же медленно вводя свой член ей во рот и выходя обратно.",
    "",
  ],
];

let fail = 0;
for (const [a, b, want] of cases) {
  const run = commonRun(a, b);
  const ok = run === want;
  if (!ok) fail++;
  console.log(`${ok ? "OK  " : "FAIL"} run=${JSON.stringify(run)}${ok ? "" : ` want=${JSON.stringify(want)}`}`);
}
process.exit(fail ? 1 : 0);
