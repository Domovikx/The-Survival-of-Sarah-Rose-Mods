{
  // TSSR-Mods: markdownlint для документов (README/AGENTS/tasks/docs/скиллы).
  // Стиль — длинные строки с осознанным переносом прозы (~100-120), таблицы
  // в md НЕ используются (хозяин: только списки) — правила таблиц оставлены
  // по умолчанию как страховка.
  "config": {
    "default": true,
    // Длина строки: лимит не навязываем.
    "MD013": false,
    // Дубли заголовков — только среди соседей.
    "MD024": { "siblings_only": true },
    // HTML-вставки допустимы (<br>, details и т.п.).
    "MD033": false,
    // Голые URL в документации — норма.
    "MD034": false,
    // H1 не обязателен.
    "MD041": false,
    // Двуязычный README: секции EN и RU — осознанные два H1-блока.
    "MD025": false,
    // Стиль колонок таблиц — за prettier.
    "MD060": false,
  },
  "globs": [
    "**/*.md",
    "!node_modules/**",
    "!**/node_modules/**",
    "!.husky/**",
    "!dist/**",
    "!**/dist/**",
    "!tmp/**",
    "!**/tmp/**",
    "!site/public/**",
  ],
}
