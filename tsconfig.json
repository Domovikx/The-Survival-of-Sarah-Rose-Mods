{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "lib": ["es2023", "dom"],
    "types": ["node"]
  },
  "include": [
    ".opencode/skills/**/*.mts",
    "patches/ai-voice-pack/tools/generate/scripts/**/*.mts",
    "patches/ai-voice-pack/casts/**/*.mts",
    "patches/ai-voice-pack/po/**/*.mts",
    "scripts/**/*.mts",
    "demo/**/*.mts"
  ],
  // tmp/ намеренно НЕ включён: там черновики и полная копия HEAD (head_baseline),
  // у site/ — свой tsconfig (jsx, paths, свои опции) — он проверяется отдельно.
  "exclude": ["node_modules", "**/node_modules", "dist", "**/dist", "tmp", "site"]
}
