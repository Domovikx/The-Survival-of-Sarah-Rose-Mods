{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "lib": ["es2023", "dom"],
    "types": ["node"]
  },
  "include": [
    ".opencode/skills/**/*.mts",
    "patches/ai-voice-pack/tools/generate/scripts/**/*.mts",
    "patches/ai-voice-pack/casts/**/*.mts",
    "patches/ai-voice-pack/po/**/*.mts"
  ]
}
