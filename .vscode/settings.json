{
  "window.title": "${dirty}${rootNameShort}",
  "editor.wordWrap": "on",
  // Формат при сохранении — prettier по конфигу репы (.prettierrc.json);
  // то же делает lint-staged на коммите, тут — чтобы сразу видеть стиль.
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "files.associations": {
    "*.rpy": "plaintext",
    "*.rpym": "plaintext",
    // Явная привязка к gettext (расширение mrorz.language-gettext) —
    // отключает автоопределение, которое на больших pot-файлах может
    // выбирать plaintext.
    "*.pot": "po",
    "*.po": "po"
  }
}
