# translation-incidents.log — журнал багов перевода (что сломалось и как лечили)
#
# Формат строки (одна строка = один инцидент):
#   YYYY-MM-DD | lang | КЛАСС | симптом (что видели) | причина (что оказалось) | лечение (чем закрыли)
#
# КЛАССЫ:
#   SHIFT   — сдвиг/вклейка: текст строки оказался у соседа
#   STALL   — прогон встал: пассы без прогресса, язык «стоит»
#   GATE    — ложный отказ валидатора (строка не проходила гейт никогда)
#   MODEL   — не та модель/бэкенд перевода
#   LOST    — потеря или порча po (нули, обрезка, пропавшие строки)
#   RUNTIME — рантайм игры (выбор файла озвучки, каталог, язык)
#
# Дописывать (в конец, не переписывая старое):
#   echo "2026-11-18 | pl | SHIFT | ... | ... | ..." >> docs/translation-incidents.log
#
# Правило: пишем ТОЛЬКО проверенное. Дату — фактическую, «проверено» — когда
# воспроизвели или увидели своими глазами. Разбор/подробности — в MAP скилла,
# здесь — хронология и связка «симптом → причина → лечение».
#
# ---------------------------------------------------------------------------

